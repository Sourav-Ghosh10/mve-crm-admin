<IfModule mod_headers.c>
  # Add CORS headers for JS, CSS, and other static assets to prevent redirect CORS blocking
  <FilesMatch "\.(js|css|png|jpe?g|gif|svg|woff|woff2|ttf|otf|eot|ico|webmanifest)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Optional: Force non-www if you prefer everything on one domain to avoid these issues altogether
  # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Existing rewrite rules for React Router (Single Page App fallback)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [QSA,L]
</IfModule>
